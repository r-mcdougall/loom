# Copy to .env at the repo root: `cp .env.docker.example .env`
# docker compose reads this file automatically.

# --- api ---
# Required. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LOG_LEVEL=info
# CORS is only relevant for local/direct-API access; the deployed frontend
# calls the API via the same-origin /api/* path proxied by Caddy.
CORS_ORIGIN=http://localhost:5173
