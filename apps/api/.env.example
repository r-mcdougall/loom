# Runtime
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
PORT=3000

# Database (bun:sqlite file path)
DATABASE_URL=./loom.db

# Access token: JWT signed with this secret (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token: opaque UUID, only its SHA-256 hash is stored
REFRESH_TOKEN_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# CORS - must match apps/web origin
CORS_ORIGIN=http://localhost:5173
